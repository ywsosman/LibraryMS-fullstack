# Copy to .env and fill in the values:  cp .env.example .env
# .env is gitignored. NEVER commit real credentials.

# --- Database ---------------------------------------------------------
DB_NAME=libraryms
DB_USERNAME=libraryms
# Required. Choose a strong password.
DB_PASSWORD=
DB_PORT=5432
# Only needed when running the app outside compose (compose sets it automatically)
DB_URL=jdbc:postgresql://localhost:5432/libraryms

# --- Application ------------------------------------------------------
APP_PORT=8080
# Required, at least 32 bytes. Generate with:  openssl rand -base64 48
JWT_SECRET=
# Comma-separated list of origins allowed by CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- First admin bootstrap (optional) ----------------------------------
# Created on startup only if no admin exists yet. Leave unset to skip.
ADMIN_USERNAME=
ADMIN_EMAIL=
# Minimum 10 characters
ADMIN_PASSWORD=
